@model MyClinic.Application.DTOs.AppointmentDto

@{
    Layout = "_Layout";
    ViewData["Title"] = "Appointment";
}

<main class="main">

    <div class="page-title">
        <div class="heading">
            <div class="container">
                <div class="row d-flex justify-content-center text-center">
                    <div class="col-lg-8">
                        <h1 class="heading-title">Appointment</h1>
                        <p class="mb-0">
                            Odio et unde deleniti. Deserunt numquam exercitationem. Officiis quo
                            odio sint voluptas consequatur ut a odio voluptatem. Sit dolorum
                            debitis veritatis natus dolores. Quasi ratione sint. Sit quaerat
                            ipsum dolorem.
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <nav class="breadcrumbs">
            <div class="container">
                <ol>
                    <li><a href="index.html">Home</a></li>
                    <li class="current">Appointment</li>
                </ol>
            </div>
        </nav>
    </div>

    <section id="appointmnet" class="appointmnet section">

        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <div class="booking-wrapper">

                        <div class="booking-header text-center">
                            <h2>Schedule Your Appointment</h2>
                            <p>
                                Book your medical appointment in just a few simple steps.
                            </p>
                        </div>

                        <div class="appointment-form">

                            @if (TempData["Error"] != null)
                            {
                                <div class="alert alert-danger">
                                    @TempData["Error"]
                                </div>
                            }

                            @if (TempData["Success"] != null)
                            {
                                <div class="alert alert-success">
                                    @TempData["Success"]
                                </div>
                            }

                            <form asp-controller="Appointment"
                                  asp-action="Appointment_Create"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                                <div class="row gy-4">

                                    <div class="col-md-6">
                                        <input asp-for="Name" class="form-control" placeholder="Full Name" />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <input asp-for="Email" class="form-control" placeholder="Email Address" />
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <input asp-for="PhoneNumber" class="form-control" placeholder="Phone Number" />
                                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <select asp-for="Department"
                                                class="form-select"
                                                asp-items="Html.GetEnumSelectList<MyClinic.Domain.Enums.DepartmentType>()">
                                            <option value="">-- Select Department --</option>
                                        </select>
                                        <span asp-validation-for="Department" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <input asp-for="AppointmentDate"
                                               type="date"
                                               class="form-control"
                                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                        <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <select asp-for="DoctorName" class="form-select">
                                            <option value="">Select Doctor</option>
                                            <option value="Dr. Sarah Johnson">Dr. Sarah Johnson</option>
                                            <option value="Dr. Michael Chen">Dr. Michael Chen</option>
                                            <option value="Dr. Emily Davis">Dr. Emily Davis</option>
                                        </select>
                                        <span asp-validation-for="DoctorName" class="text-danger"></span>
                                    </div>

                                    <div class="col-12">
                                        <textarea asp-for="Message"
                                                  class="form-control"
                                                  rows="4"
                                                  placeholder="Additional notes"></textarea>
                                    </div>

                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary btn-lg w-100">
                                            Book Appointment Now
                                        </button>
                                    </div>

                                </div>

                            </form>

                        </div>

                    </div>
                </div>
            </div>

        </div>

    </section>

</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}